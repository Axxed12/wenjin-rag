# Add to the deployment environment used with compose.mcp-control.yaml.
# The file must contain a random token with at least 32 characters.
WENJIN_MCP_CONTROL_TOKEN_FILE=deploy/secrets/mcp_control_token
WENJIN_MCP_CONTROL_PROJECT=wenjin
WENJIN_MCP_LEGACY_PUBLIC_URL=http://127.0.0.1:18765/mcp
WENJIN_MCP_STATELESS_PUBLIC_URL=http://127.0.0.1:18768/mcp-stateless
