# Copy to deploy/.env.local or deploy/.env.cloud; never commit populated files.
# Compose commands use --env-file and --project-directory . from the repository root.

# Host-side paths; shared content mounts read-only. Paths are relative to the repository root.
WENJIN_INDEX_ROOT=./data/indexes
WENJIN_RAW_DATA_ROOT=./raw_data
WENJIN_CORPORA_ROOT=./corpora
WENJIN_CONFIG_ROOT=./configs
EMBEDDING_MODEL_PATH=./models/Qwen3-Embedding-0.6B
RERANKER_MODEL_PATH=./models/Qwen3-Reranker-0.6B

# Local secret files live under the ignored deploy/secrets directory; production may use an external path.
WENJIN_MODEL_API_TOKEN_FILE=deploy/secrets/model_api_token
WENJIN_FILE_ADMIN_TOKEN_FILE=deploy/secrets/file_admin_token
MODEL_NODE_CA_BUNDLE_FILE=deploy/secrets/model-node-ca-bundle.pem

# Stable names must match authenticated GET /v1/identity on the model node.
EMBEDDING_MODEL_ID=Qwen3-Embedding-0.6B
RERANKER_MODEL_ID=Qwen3-Reranker-0.6B

# Local profile maps the host ports only to loopback.
WENJIN_ADMIN_BIND_ADDRESS=127.0.0.1
WENJIN_ADMIN_PORT=18777
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=18765
WENJIN_MCP_ALLOWED_HOSTS=localhost:18765,127.0.0.1:18765

# Cloud profile: replace with a DNS name and TLS model API endpoint reachable over VPN/private routing.
PUBLIC_DOMAIN=rag.example.invalid
WENJIN_MODEL_API_URL=https://model-node.vpn.internal:18766
WENJIN_MCP_ALLOWED_HOSTS=rag.example.invalid,rag.example.invalid:443
WENJIN_PROXY_SUBNET=172.30.250.0/29
WENJIN_PROXY_TRUSTED_IP=172.30.250.2

# GPU model-node profile. Default host bind is loopback; use a VPN interface address only when needed.
MODEL_NODE_BIND_ADDRESS=127.0.0.1
MODEL_NODE_TLS_PORT=18766
MODEL_NODE_TLS_NAME=model-node.vpn.internal
MODEL_NODE_CERT_FILE=deploy/secrets/model-node.crt
MODEL_NODE_KEY_FILE=deploy/secrets/model-node.key

# Model and upload controls may be adjusted only through reviewed configuration.
WENJIN_FILE_MAX_UPLOAD_BYTES=104857600
