ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.3
FROM ${UV_IMAGE} AS uv-bin

FROM python:3.12.3-slim-bookworm AS lxml-builder
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN --mount=type=secret,id=build_proxy \
    if [ -s /run/secrets/build_proxy ]; then \
        proxy=$(cat /run/secrets/build_proxy); \
        export http_proxy="$proxy" https_proxy="$proxy" HTTP_PROXY="$proxy" HTTPS_PROXY="$proxy"; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# lxml 6.1.3's Windows wheel is built with libxml2 2.11.9. Keep the Linux
# parser runtime aligned so html-line-v1 replays the same indexed source text.
ENV STATIC_DEPS=true \
    LIBXML2_VERSION=2.11.9 \
    LIBXSLT_VERSION=1.1.39 \
    LIBICONV_VERSION=1.18 \
    ZLIB_VERSION=1.3.2 \
    DOWNLOAD_DIR=/tmp/lxml-static-inputs \
    MULTICORE=2 \
    CFLAGS="-O2 -fPIC"
COPY --from=lxml-static-inputs / /tmp/lxml-static-inputs/
COPY deploy/lxml-sources.json deploy/prepare_lxml_build.py /tmp/
RUN python /tmp/prepare_lxml_build.py \
    && mkdir -p /tmp/lxml-wheelhouse \
    && python -m pip wheel -v --no-deps --no-binary=lxml \
        --wheel-dir=/tmp/lxml-wheelhouse /tmp/lxml-source/lxml-6.1.3

FROM python:3.12.3-slim-bookworm AS mcp-stateless
ARG UV_BIN=/uv
ARG UVX_BIN=/uvx
COPY --from=uv-bin ${UV_BIN} ${UVX_BIN} /usr/local/bin/
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple \
    PATH=/app/mcp-stateless/.venv/bin:$PATH \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HOME=/tmp/huggingface \
    LLAMA_INDEX_CACHE_DIR=/tmp/llama_index \
    TMPDIR=/tmp \
    WENJIN_PROJECT_ROOT=/app

RUN groupadd --gid 10001 wenjin \
    && useradd --uid 10001 --gid 10001 --create-home wenjin \
    && install -d -o wenjin -g wenjin /app/data /app/raw_data /app/artifacts /var/lib/wenjin \
    && install -d -o root -g root -m 1777 /tmp
WORKDIR /app

COPY mcp-stateless/pyproject.toml mcp-stateless/uv.lock ./mcp-stateless/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project mcp-stateless --locked --no-dev --no-install-project
COPY --from=lxml-builder /tmp/lxml-wheelhouse /tmp/lxml-wheelhouse
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /app/mcp-stateless/.venv/bin/python --no-deps --reinstall \
        /tmp/lxml-wheelhouse/lxml-*.whl \
    && /app/mcp-stateless/.venv/bin/python -c \
        "from lxml import etree; assert etree.LIBXML_VERSION == (2,11,9), etree.LIBXML_VERSION; assert etree.LIBXML_COMPILED_VERSION == (2,11,9), etree.LIBXML_COMPILED_VERSION; print({'lxml': etree.LXML_VERSION, 'libxml_runtime': etree.LIBXML_VERSION, 'libxml_compiled': etree.LIBXML_COMPILED_VERSION})" \
    && rm -rf /tmp/lxml-wheelhouse

COPY src ./src
COPY deploy/with-secrets.sh /usr/local/bin/with-secrets
ENV PYTHONPATH=/app/src
RUN chmod 0755 /usr/local/bin/with-secrets \
    && chown -R wenjin:wenjin /app/src
USER wenjin
ENTRYPOINT ["/usr/local/bin/with-secrets"]
CMD ["python", "-m", "wenjin.mcp.stateless_server", "--host", "0.0.0.0", "--port", "18768", "--identity-db", "/var/lib/wenjin/identity.sqlite"]
