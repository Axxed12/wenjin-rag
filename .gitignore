.venv/
build/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.env
.env.*
!.env.example
!.env.*.example
*.egg-info/
artifacts/audit/
artifacts/tls/
*.key
secrets/
deploy/secrets/
*.pem
# 可由脚本重建的本地索引和解析衍生件
data/indexes/*.sqlite
# 运行时索引注册表：记录当前 active 目标及其切换历史。
# 把它当成本地部署状态，不是源码——切到非公开目标后，active/history/events 里会留下
# 内部 corpus 的 target_id、collection 名和 manifest 路径；即使之后切回公开目标，
# 那些字段仍留在历史记录里。新克隆用 `manage_indexes.py init` 就地生成。
data/indexes/index-registry.json
data/packages/parse-lab/scan.pdf
data/packages/parse-lab/page-image.png
artifacts/runs/parse-lab-001/*.png
# Docker离线制品与本地模型不得进入Git
*.tar
*.tar.gz
models/
# 原始语料由manifest和导入脚本恢复，不进入Git。
raw_data/
# 非公开语料：manifest里含内部文件名和目录结构，同样不能进公开仓库。
corpora-private/
# 非公开语料的索引目标配置：配置里有内部corpus_id和manifest路径。
# 只忽略corpora-private/是不够的——配置默认写在configs/indexes/，那条路会绕过忽略规则。
configs/indexes-private/
# 访问策略是部署配置：client_id与部署环境绑定，内部语料的corpus_id也会泄露内部命名。
configs/access/
# 本轮验收候选包含原始资料副本；仅提交正式manifest和精简验收证据。
artifacts/corpus-acceptance-001/candidate/
# 第三方原文副本不进公开仓库：OGC规范页/XSD和PROJ文档只在本机保留，
# 公开仓库通过corpora里的manifest记录来源URL、固定版本和逐文件Hash。
artifacts/corpus-acceptance-001/ogc-license.html
artifacts/corpus-acceptance-001/wms-page-3.png
artifacts/corpus-acceptance-001/wms-upstream.xsd
artifacts/corpus-acceptance-001/proj-about-core-pinned.rst
artifacts/corpus-acceptance-001/proj-index-pinned.rst
# 候选索引是派生数据，与 data/indexes/*.sqlite 同理不进仓库：
# artifacts/chinese-bm25/verify_candidate.py 可原地重建它，验证结论记在 report.json。
artifacts/*/*.sqlite
# 管理界面隔离预览的临时数据库和合成原文；验收摘要保留在父目录。
artifacts/iterations/2026-10-06-admin-frontend/preview-root/
artifacts/iterations/2026-10-06-admin-frontend/backend-wheel-check/
artifacts/iterations/2026-10-07-admin-improvements/preview-root/
artifacts/iterations/2026-10-07-admin-improvements/wheel-check/
artifacts/iterations/2026-10-07-admin-improvements/snapshot-probe-root/
# 管理登记、调用历史和受管副本属于本机运行数据，不发布到仓库。
data/file-management/
# 忽略所有目录中的 Markdown 文档
*.md
# 保留适合仓库公开展示的文档
