# 复制为 .env，生成自己的本地开发 API key，不要提交 .env。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=replace-with-your-own-key
MINERU_URL=http://127.0.0.1:8000
EMBEDDING_MODEL_PATH=./models/Qwen3-Embedding-0.6B
RERANKER_MODEL_PATH=./models/Qwen3-Reranker-0.6B
# 原始语料总目录；可指向人工摆渡到内网的只读目录。
WENJIN_RAW_DATA_ROOT=./raw_data
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# MCP审计默认输出JSONL到stdout，供Docker日志驱动收集。
WENJIN_AUDIT_SINK=stdout
# 仅公开问题调试时设为1；内网默认0，只记录query SHA256和长度。
WENJIN_AUDIT_INCLUDE_QUERY=0
# WENJIN_AUDIT_PATH=artifacts/audit/search_docs.jsonl  # sink=file时可选
# Docker MCP默认只绑定本机；跨机器时改为0.0.0.0并列出实际Host:port。
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8765
MCP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765
# 安全部署覆盖：至少24字符；不要提交真实值。
WENJIN_MCP_API_KEY=replace-with-at-least-24-random-characters
WENJIN_MCP_CLIENT_ID=claude-code
# 自签名仅用于开发；生产使用内网CA或TLS反向代理。
WENJIN_TLS_CERT_FILE=E:/path/to/server.crt
WENJIN_TLS_KEY_FILE=E:/path/to/server.key
# Query 改写实验使用 OpenAI 兼容接口；内网部署时可指向 LiteLLM。
QUERY_REWRITE_BASE_URL=https://your-openai-compatible-service/v1
QUERY_REWRITE_API_KEY=replace-with-query-rewrite-key
QUERY_REWRITE_MODEL=replace-with-model-name
QUERY_REWRITE_TIMEOUT_SECONDS=60
# 生成模型后端将在后续接入，不在环境检查中猜测地址或密钥。
