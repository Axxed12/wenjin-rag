{
  "task": "中文分词检索（jieba）",
  "date": "2026-09-21",
  "paths_are_placeholders": true,
  "what_changed": {
    "new_module": "src/wenjin/indexing/zh.py",
    "modified": [
      "src/wenjin/indexing/bm25.py",
      "src/wenjin/mcp_server.py",
      "src/wenjin/retrieval/service.py (仅测试断言，源码未改)",
      "pyproject.toml / uv.lock (jieba>=0.42.1)",
      "Dockerfile",
      "README.md / code.md",
      "tests/test_bm25.py / tests/test_zh_segmentation.py / tests/test_retrieval_service.py"
    ],
    "table_schema_unchanged": true,
    "evidence_text_unchanged": "raw_text 仍写未切分的 chunk.text，bm25_query 返回的 text 仍取 raw_text",
    "lazy_loading": "jieba 只在 segment_cjk/cjk_terms 遇到 CJK 时 import；实测 import wenjin.mcp_server 后 'jieba' in sys.modules 为 False",
    "prewarm": "mcp_server.create_runtime 启动时调 prewarm_zh()",
    "new_contract": "索引与查询必须使用同一版 jieba；换版本必须重建 BM25 索引，否则词元对不上，中文检索静默返回空结果（不报错）",
    "scope_correction": "**不要把本次修复说成「混合检索退化成单路向量召回」。** 冻结 test 的 40 题全是中文查询，但每题都内嵌英文标识符（gdal_translate/ogr2ogr/GeoTransform/b3dm…），平均 3.90 个英文检索词，没有一题提取不到检索词——BM25 对这些题本来就在出力。本次修复真正解决的是**一个英文都不带**的纯中文查询（query_terms 返回空列表）和**纯中文文档**（整段中文变成一个词元），即国内内网资料的常见形态。"
  },
  "callers_audited": {
    "src/wenjin/retrieval/service.py:161": "query_terms 只作分路开关（terms 为空则 keyword=[]），随后把原 query 交给 bm25_query 重新提词。中文词进来后开关打开，链路自洽。",
    "src/wenjin/retrieval/router.py:312": "同上，逐库分路，同样自洽。",
    "evaluation/run_retrieval_eval.py": "同上；identifiers 支路用 code_identifier_terms 过滤。",
    "evaluation/run_reranker_eval.py": "同上。",
    "evaluation/inspect_misses.py": "只把 terms 写进报告的 bm25_terms 字段，无逻辑分支。",
    "evaluation/run_query_rewrite_eval.py": "routed_bm25 把完整 terms 作 terms_override 传下去；中文词与切分后的索引同词元空间，正确。",
    "evaluation/run_multicorpus_eval.py": "同 service.py 的开关用法。",
    "code_identifier_terms()": "过滤条件是 '_' in term 或 re.search('[a-z][A-Z]', term)。中文词两者都不满足，被自然过滤掉——已确认，不需要额外处理。副作用：中文查询不会污染 include/% 头文件支路。",
    "expand_query()": "按短语命中追加英文别名，不消费 query_terms；中文不受影响。扩展后的 query 会同时给出中文词（原问题）和英文词（追加），正是想要的行为。",
    "source_routes()": "只看中文短语决定来源前缀，与 query_terms 无关，未受影响。",
    "术语空间提醒": "bm25_query(terms_override=...) 不会对 override 再切分；调用方必须传已切分的词（query_terms 或 code_identifier_terms 的输出）。已在 docstring 注明，当前全部调用方符合。"
  },
